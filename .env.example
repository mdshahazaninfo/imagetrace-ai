# Public Supabase settings (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Vision API key (server-only)
GOOGLE_VISION_API_KEY=

# Preferred web search provider
BRAVE_SEARCH_API_KEY=

# Optional legacy Google Programmable Search fallback (existing customers only)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Runtime options
MAX_IMAGE_MB=4
SAVE_ANALYSIS_TO_SUPABASE=true
